# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAH...

# Необязательно. Ваш числовой Telegram ID. Если не указать — владельцем станет
# первый, кто нажмёт «Старт» в боте.
# OWNER_ID=

# Необязательно. HTTP-прокси, если Telegram на этом компьютере без него не открывается.
# TELEGRAM_PROXY=http://user:password@host:port

# Необязательно. Часовой пояс для времени в сообщениях.
# TZ_NAME=Europe/Moscow
